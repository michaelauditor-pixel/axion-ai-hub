diff -ruN '--exclude=*.orig' '--exclude=assets' nc_v19_base/test/v21_product_audit_test.dart nc_v21_work/src/test/v21_product_audit_test.dart
--- nc_v19_base/test/v21_product_audit_test.dart	1970-01-01 00:00:00.000000000 +0000
+++ nc_v21_work/src/test/v21_product_audit_test.dart	2026-10-04 00:58:31.503528738 +0000
@@ -0,0 +1,51 @@
+import 'dart:io';
+import 'dart:math';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:neurocore_app/core/product_info.dart';
+import 'package:neurocore_app/features/g06_social/social_scenario.dart';
+
+void main() {
+  test('product positioning has age and clinical boundary', () {
+    expect(ProductInfo.recommendedAge, '6 a 11 anos');
+    expect(ProductInfo.clinicalBoundary.toLowerCase(), contains('não realiza diagnóstico'));
+    expect(ProductInfo.clinicalBoundary.toLowerCase(), contains('não trata tdah'));
+  });
+
+  test('G06 accepts multiple supportive responses in every story', () {
+    expect(SocialScenario.examples.length, greaterThanOrEqualTo(10));
+    final random = Random(22);
+    for (final scenario in SocialScenario.examples) {
+      expect(scenario.supportiveIndices.length, greaterThanOrEqualTo(2));
+      final presented = scenario.present(
+        random: random,
+        choiceCount: 4,
+        preferredPosition: 1,
+      );
+      expect(presented.supportiveIndices.length, greaterThanOrEqualTo(2));
+      expect(presented.preferredIndex, 1);
+    }
+  });
+
+  test('G05 contains real guided practice rather than passive labels', () {
+    final source = File('lib/features/g05_regulation/g05_screen.dart').readAsStringSync();
+    expect(source, contains('_runGuidedPractice'));
+    expect(source, contains('Puxe o ar devagar'));
+    expect(source, contains('Mãos fortes, mãos soltas'));
+    expect(source, contains('3–2–1 dos sentidos'));
+  });
+
+  test('child home does not expose engineering jargon or stale versions', () {
+    final source = File('lib/features/home/home_screen.dart').readAsStringSync();
+    expect(source, isNot(contains('ML shadow')));
+    expect(source, isNot(contains('V0.6')));
+    expect(source, isNot(contains('V1.7')));
+    expect(source, isNot(contains('V1.9 AUDITED')));
+  });
+
+  test('G01 tutorial explains target-absent trials', () {
+    final source = File('lib/features/g01_focus/g01_screen.dart').readAsStringSync();
+    expect(source, contains('Se ela não aparecer'));
+    expect(source, contains('não toque em nada'));
+  });
+}
