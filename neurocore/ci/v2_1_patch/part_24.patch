+import 'package:flutter_test/flutter_test.dart';
+import 'package:neurocore_app/core/product/product_info.dart';
+import 'package:neurocore_app/core/profile/neuro_profile_aggregator.dart';
+import 'package:neurocore_app/features/g06_social/social_scenario.dart';
+
+void main() {
+  test('V2.1 has explicit age and neuroeducational boundary', () {
+    expect(ProductInfo.version, '2.1.0+21');
+    expect(ProductInfo.recommendedAge, '6 a 11 anos');
+    expect(ProductInfo.positioning.toLowerCase(), contains('neuroeducacional'));
+    expect(ProductInfo.clinicalBoundary.toLowerCase(), contains('não realiza diagnóstico'));
+    expect(ProductInfo.audience.toLowerCase(), contains('sem afirmar tratamento'));
+  });
+
+  test('parent indicators require repeated sessions in the same domain', () {
+    expect(NeuroProfileAggregator.minimumSessionsPerDomain, 3);
+  });
+
+  test('every social story offers more than one respectful path', () {
+    expect(SocialScenario.examples.length, greaterThanOrEqualTo(8));
+    for (final scenario in SocialScenario.examples) {
+      expect(
+        scenario.choices.where((choice) => choice.supportive).length,
+        greaterThanOrEqualTo(2),
+        reason: scenario.story,
+      );
+      expect(
+        scenario.choices.where((choice) => !choice.supportive).length,
+        greaterThanOrEqualTo(1),
+        reason: scenario.story,
+      );
+    }
+  });
+}
