text context) {
+    final progress = (stepIndex + 1) / exercise.steps.length;
+    return Container(
+      padding: const EdgeInsets.all(22),
+      decoration: BoxDecoration(
+        color: const Color(0xFFEAF8F2),
+        borderRadius: BorderRadius.circular(28),
+      ),
+      child: Column(
+        mainAxisAlignment: MainAxisAlignment.center,
+        children: [
+          Icon(exercise.icon, size: 84, color: const Color(0xFF27856E)),
+          const SizedBox(height: 18),
+          Text(
+            exercise.title,
+            textAlign: TextAlign.center,
+            style: const TextStyle(fontSize: 25, fontWeight: FontWeight.w900),
+          ),
+          const SizedBox(height: 18),
+          AnimatedSwitcher(
+            duration: const Duration(milliseconds: 220),
+            child: Text(
+              message,
+              key: ValueKey('$stepIndex-$message'),
+              textAlign: TextAlign.center,
+              style: const TextStyle(fontSize: 22, height: 1.35, fontWeight: FontWeight.w800),
+            ),
+          ),
+          const SizedBox(height: 24),
+          ClipRRect(
+            borderRadius: BorderRadius.circular(99),
+            child: LinearProgressIndicator(value: progress, minHeight: 10),
+          ),
+          const SizedBox(height: 8),
+          Text('Passo ${stepIndex + 1} de ${exercise.steps.length}'),
+        ],
+      ),
+    );
+  }
+}
