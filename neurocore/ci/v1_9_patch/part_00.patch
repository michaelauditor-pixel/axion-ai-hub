diff -ruN source_before/lib/core/feedback/game_feedback_service.dart source_after/lib/core/feedback/game_feedback_service.dart
--- source_before/lib/core/feedback/game_feedback_service.dart	1970-01-01 00:00:00.000000000 +0000
+++ source_after/lib/core/feedback/game_feedback_service.dart	2026-08-21 14:41:46.510891470 +0000
@@ -0,0 +1,52 @@
+import 'dart:async';
+
+import 'package:flutter/services.dart';
+
+import '../accessibility/accessibility_service.dart';
+
+/// Feedback audiovisual leve e não punitivo para a área infantil.
+/// Usa apenas recursos do sistema, sem SDKs externos ou rastreamento.
+class GameFeedbackService {
+  const GameFeedbackService({required AccessibilityService accessibility})
+    : _accessibility = accessibility;
+
+  final AccessibilityService _accessibility;
+
+  Future<void> start() async {
+    await _soundPulse(count: 1);
+    if (_accessibility.preferences.hapticsEnabled) {
+      await HapticFeedback.selectionClick();
+    }
+  }
+
+  Future<void> correct() async {
+    await _soundPulse(count: 2, spacingMs: 70);
+    if (_accessibility.preferences.hapticsEnabled) {
+      await HapticFeedback.lightImpact();
+    }
+  }
+
+  Future<void> gentleMiss() async {
+    await _soundPulse(count: 1);
+    if (_accessibility.preferences.hapticsEnabled) {
+      await HapticFeedback.selectionClick();
+    }
+  }
+
+  Future<void> complete() async {
+    await _soundPulse(count: 3, spacingMs: 85);
+    if (_accessibility.preferences.hapticsEnabled) {
+      await HapticFeedback.mediumImpact();
+    }
+  }
+
+  Future<void> _soundPulse({required int count, int spacingMs = 60}) async {
+    if (!_accessibility.preferences.soundEnabled) return;
+    for (var i = 0; i < count; i += 1) {
+      await SystemSound.play(SystemSoundType.click);
+      if (i + 1 < count) {
+        await Future<void>.delayed(Duration(milliseconds: spacingMs));
+      }
+    }
+  }
+}
