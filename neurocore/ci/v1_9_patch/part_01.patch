+  List<bool> generatePresenceSchedule(
+    DifficultyConfig config,
+    int trialCount, {
+    int maxConsecutiveSame = 4,
+  }) {
+    if (trialCount < 4) {
+      throw ArgumentError.value(trialCount, 'trialCount', 'must be >= 4');
+    }
+    final desiredTargets = (config.targetProbability * trialCount).round();
+    final targetCount = desiredTargets.clamp(2, trialCount - 2).toInt();
+    final schedule = <bool>[
+      ...List<bool>.filled(targetCount, true),
+      ...List<bool>.filled(trialCount - targetCount, false),
+    ];
+
+    bool valid(List<bool> values) {
+      var run = 0;
+      bool? previous;
+      for (final value in values) {
+        if (previous == value) {
+          run += 1;
+        } else {
+          previous = value;
+          run = 1;
+        }
+        if (run > maxConsecutiveSame) return false;
+      }
+      return true;
+    }
+
+    for (var attempt = 0; attempt < 250; attempt += 1) {
+      schedule.shuffle(_random);
+      if (valid(schedule)) return List<bool>.of(schedule);
+    }
+
+    // Fallback alternado preservando a contagem planejada.
+    final result = <bool>[];
+    var remainingTargets = targetCount;
+    var remainingAbsent = trialCount - targetCount;
+    var preferTarget = true;
+    while (remainingTargets + remainingAbsent > 0) {
+      if ((preferTarget && remainingTargets > 0) || remainingAbsent == 0) {
+        result.add(true);
+        remainingTargets -= 1;
+      } else {
+        result.add(false);
+        remainingAbsent -= 1;
+      }
+      preferTarget = !preferTarget;
+    }
+    return result;
+  }
