-    return InhibitionTrial(cue: isGo ? InhibitionCue.go : InhibitionCue.noGo);
+  /// Gera um bloco balanceado de Go/No-Go.
+  ///
+  /// Regras de segurança pedagógica:
+  /// - pelo menos 2 estímulos PARE por bloco de 10;
+  /// - respeita aproximadamente a probabilidade-alvo de VÁ do nível;
+  /// - nunca permite mais de [maxConsecutiveGo] estímulos VÁ consecutivos,
+  ///   inclusive considerando o final do bloco anterior.
+  List<InhibitionTrial> generateBlock(
+    InhibitionDifficultyConfig config,
+    int trialCount, {
+    int initialGoRun = 0,
+    int maxConsecutiveGo = 3,
+  }) {
+    if (trialCount < 3) {
+      throw ArgumentError.value(trialCount, 'trialCount', 'must be >= 3');
+    }
+
+    final desiredNoGo = ((1 - config.goProbability) * trialCount).round();
+    final minNoGo = trialCount >= 8 ? 2 : 1;
+    final noGoCount = desiredNoGo.clamp(minNoGo, trialCount - 1).toInt();
+    final goCount = trialCount - noGoCount;
+
+    final cues = <InhibitionCue>[
+      ...List<InhibitionCue>.filled(goCount, InhibitionCue.go),
+      ...List<InhibitionCue>.filled(noGoCount, InhibitionCue.noGo),
+    ];
+
+    for (var attempt = 0; attempt < 400; attempt += 1) {
+      cues.shuffle(_random);
+      if (_isValidSequence(
+        cues,
+        initialGoRun: initialGoRun,
+        maxConsecutiveGo: maxConsecutiveGo,
+      )) {
+        return cues.map((cue) => InhibitionTrial(cue: cue)).toList();
+      }
+    }
+
+    // Fallback determinístico: distribui PARE ao longo do bloco.
+    final result = <InhibitionCue>[];
+    var remainingGo = goCount;
+    var remainingNoGo = noGoCount;
+    var currentGoRun = initialGoRun;
+    while (remainingGo + remainingNoGo > 0) {
+      final mustStop = currentGoRun >= maxConsecutiveGo;
+      final canPlaceStop = remainingNoGo > 0;
+      final shouldStop = mustStop ||
+          (canPlaceStop && remainingGo > 0 &&
+              remainingNoGo / (remainingGo + remainingNoGo) >=
+                  _random.nextDouble());
+      if (shouldStop && canPlaceStop) {
+        result.add(InhibitionCue.noGo);
+        remainingNoGo -= 1;
+        currentGoRun = 0;
+      } else if (remainingGo > 0) {
+        result.add(InhibitionCue.go);
+        remainingGo -= 1;
+        currentGoRun += 1;
+      } else {
+        result.add(InhibitionCue.noGo);
+        remainingNoGo -= 1;
+        currentGoRun = 0;
+      }
+    }
+
+    return result.map((cue) => InhibitionTrial(cue: cue)).toList();
+  }
+
+  bool _isValidSequence(
+    List<InhibitionCue> cues, {
+    required int initialGoRun,
+    required int maxConsecutiveGo,
+  }) {
+    var goRun = initialGoRun;
+    for (final cue in cues) {
+      if (cue == InhibitionCue.go) {
+        goRun += 1;
+        if (goRun > maxConsecutiveGo) return false;
+      } else {
+        goRun = 0;
+      }
+    }
+    return true;
+  }
+
+  static int trailingGoRun(List<InhibitionTrial> trials) {
+    var run = 0;
+    for (final trial in trials.reversed) {
+      if (!trial.isGo) break;
+      run += 1;
+    }
+    return run;
   }
 }
