diff -ruN source_before/lib/features/g02_inhibition/inhibition_trial.dart source_after/lib/features/g02_inhibition/inhibition_trial.dart
--- source_before/lib/features/g02_inhibition/inhibition_trial.dart	2026-08-21 13:15:46.000000000 +0000
